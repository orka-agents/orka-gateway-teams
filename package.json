{
  "name": "orka-gateway-teams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "test:container": "node --import tsx test/support/container-smoke.ts",
    "test:deployment": "node --import tsx test/support/deployment-smoke.ts",
    "test:app-package": "node --import tsx --test test/support/teams-app-package.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/ingress/main.js serve",
    "setup:capture": "node dist/setup/main.js",
    "init:ingress": "node dist/ingress/main.js init",
    "init:delivery": "node dist/ingress/main.js init-delivery",
    "preview:card": "node --import tsx scripts/preview-card.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@azure/core-rest-pipeline": "1.25.0",
    "@azure/data-tables": "13.3.2",
    "@azure/msal-node": "5.6.0",
    "@microsoft/teams.api": "2.0.16",
    "@microsoft/teams.apps": "2.0.16",
    "@microsoft/teams.cards": "2.0.16",
    "@microsoft/teams.common": "2.0.16",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@azure/core-tracing": "1.4.0",
    "@azure/logger": "1.4.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
